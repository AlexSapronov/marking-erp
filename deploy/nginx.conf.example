# Replace hostname/certificate paths. Bind/access restrictions belong to corporate IT.
server {
    listen 443 ssl;
    server_name erp.internal.example;
    ssl_certificate /etc/marking-erp/tls/fullchain.pem;
    ssl_certificate_key /etc/marking-erp/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
